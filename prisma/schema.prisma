generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  email                String    @unique @db.VarChar(255)
  passwordHash         String    @map("password_hash") @db.VarChar(255)
  resetPasswordToken   String?   @map("reset_password_token") @db.VarChar(255)
  resetPasswordExpires DateTime? @map("reset_password_expires") @db.Timestamptz
  resetPasswordAttempts Int      @default(0) @map("reset_password_attempts")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  profile       Profile?
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Refresh tokens opacos, guardados só como hash e rotacionados a cada uso.
/// Tokens da mesma cadeia de rotação compartilham `familyId`: se um token já
/// usado reaparecer (roubo/replay), a cadeia inteira é revogada.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Objetivo corporal da pessoa. Muda o significado dos dados no pet (ex.:
/// em RECOVER, ganhar peso é conquista e magreza nunca é).
enum BodyGoal {
  LOSE
  DEFINE
  GAIN
  MAINTAIN
  RECOVER
}

/// Partes do app que a pessoa escolheu acompanhar. O pet só reage ao que está ativo.
enum TrackedModule {
  MEDICATION
  HYDRATION
  EXERCISE
  WEIGHT
  MEALS
}

model Profile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  name               String    @db.VarChar(255)
  timezone           String    @default("UTC") @db.VarChar(50)
  avatarUrl          String?   @map("avatar_url")
  dailyHydrationGoal Int       @default(2000) @map("daily_hydration_goal")
  heightCm           Int?      @map("height_cm")
  bodyGoal           BodyGoal? @map("body_goal")
  targetWeightKg     Decimal?  @map("target_weight_kg") @db.Decimal(5, 2)
  /// IMC mínimo saudável usado como piso nas metas de peso (ajustável).
  healthFloorBmi     Decimal   @default(18.5) @map("health_floor_bmi") @db.Decimal(3, 1)
  trackedModules     TrackedModule[] @map("tracked_modules")
  /// false = modo "só hábitos": o corpo do pet não acompanha o peso.
  bodyMirror         Boolean   @default(true) @map("body_mirror")
  /// Quando a pessoa passou pelo "Sobre você"; nulo = conta antiga ou pulou.
  setupCompletedAt   DateTime? @map("setup_completed_at") @db.Timestamptz
  coins              Int       @default(0)
  petName            String    @default("Nix") @map("pet_name") @db.VarChar(100)
  petStatus          String    @default("HAPPY") @map("pet_status") @db.VarChar(50)
  petSpecies         String    @default("CAT") @map("pet_species") @db.VarChar(30)
  petDna             Json?     @map("pet_dna")
  currentXp          Int       @default(0) @map("current_xp")
  streakDays         Int       @default(0) @map("streak_days")
  maxStreakDays      Int       @default(0) @map("max_streak_days")
  lastActiveDate     String?   @map("last_active_date") @db.VarChar(10)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  medications    Medication[]
  medicationLogs MedicationLog[]
  hydrationLogs  HydrationLog[]
  weightLogs     WeightLog[]
  exerciseLogs   ExerciseLog[]
  xpEvents       XpEvent[]
  coinEvents     CoinEvent[]
  restDays       RestDay[]
  goals          Goal[]

  @@map("profiles")
}

/// Livro-razão de XP: permite limite diário, auditoria e recálculo.
model XpEvent {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  action    String   @db.VarChar(50)
  refId     String   @default("") @map("ref_id") @db.VarChar(64)
  dayKey    String   @map("day_key") @db.VarChar(10)
  xp        Int
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, dayKey, action])
  @@map("xp_events")
}

model Medication {
  id         String    @id @default(uuid()) @db.Uuid
  profileId  String    @map("profile_id") @db.Uuid
  name       String    @db.VarChar(255)
  dosage     String    @db.VarChar(100)
  stockCount Int       @default(0) @map("stock_count")
  timeOfDay  String    @map("time_of_day") @db.VarChar(5)
  color      String    @default("#E24A5C") @db.VarChar(7)
  icon       String    @default("pill") @db.VarChar(50)
  frequency  String    @default("DAILY") @db.VarChar(50)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  profile Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  logs    MedicationLog[]

  @@map("medications")
}

enum MedicationStatus {
  TAKEN
  SKIPPED
  MISSED
}

model MedicationLog {
  id           String           @id @default(uuid()) @db.Uuid
  medicationId String           @map("medication_id") @db.Uuid
  profileId    String           @map("profile_id") @db.Uuid
  status       MedicationStatus
  loggedAt     DateTime         @map("logged_at") @db.Timestamptz
  createdAt    DateTime         @default(now()) @map("created_at")

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  profile    Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, loggedAt])
  @@map("medication_logs")
}

model HydrationLog {
  id            String   @id @default(uuid()) @db.Uuid
  profileId     String   @map("profile_id") @db.Uuid
  amountMl      Int      @map("amount_ml")
  containerType String   @default("glass") @map("container_type") @db.VarChar(50)
  loggedAt      DateTime @map("logged_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, loggedAt])
  @@map("hydration_logs")
}

model WeightLog {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  weightKg  Decimal  @map("weight_kg") @db.Decimal(5, 2)
  loggedAt  DateTime @map("logged_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, loggedAt])
  @@map("weight_logs")
}

model ExerciseLog {
  id              String   @id @default(uuid()) @db.Uuid
  profileId       String   @map("profile_id") @db.Uuid
  didExercise     Boolean  @map("did_exercise")
  durationMinutes Int?     @map("duration_minutes")
  loggedAt        DateTime @map("logged_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, loggedAt])
  @@map("exercise_logs")
}
/// Livro-razão de moedas. Moedas vêm de metas cumpridas (nunca de velocidade)
/// e só compram itens cosméticos. A chave única torna cada prêmio idempotente.
model CoinEvent {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  amount    Int
  reason    String   @db.VarChar(40)
  refId     String   @default("") @map("ref_id") @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, reason, refId])
  @@index([profileId, createdAt])
  @@map("coin_events")
}

/// Dia em que a pessoa pediu para descansar: protege a sequência.
model RestDay {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  dayKey    String   @map("day_key") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, dayKey])
  @@map("rest_days")
}

enum GoalType {
  WEIGHT
  WEEKLY_WORKOUTS
}

enum GoalDirection {
  LOSE
  GAIN
  MAINTAIN
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  CANCELLED
}

/// Meta de longo prazo. Em metas de peso, `checkpoints` guarda os degraus
/// intermediários [{ value, achievedAt }]; `rewardTarget` é o alvo que dá
/// recompensa (o piso de saúde, quando o alvo da pessoa fica abaixo dele).
model Goal {
  id           String        @id @default(uuid()) @db.Uuid
  profileId    String        @map("profile_id") @db.Uuid
  type         GoalType
  direction    GoalDirection
  status       GoalStatus    @default(ACTIVE)
  startValue   Decimal       @map("start_value") @db.Decimal(6, 2)
  targetValue  Decimal       @map("target_value") @db.Decimal(6, 2)
  rewardTarget Decimal       @map("reward_target") @db.Decimal(6, 2)
  checkpoints  Json          @default("[]")
  startedAt    DateTime      @default(now()) @map("started_at")
  achievedAt   DateTime?     @map("achieved_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
  @@map("goals")
}
